# Public API origin is proxied to the Django backend in development.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Public Owner registration is POST /api/auth/register in this backend.
# No VITE_REGISTER_ENDPOINT or client-selected role is needed.

# The injury diagram uses a bundled transparent photo. Demo is opt-in only.
# Restart Vite after changing this flag. Only enter fictitious data in demo.
VITE_INJURY_DIAGRAM_DEMO=false

# Optional same-origin PNG/WebP overrides; align to the matching 1448x1086
# photo profile in horseDiagram.js. New geometry needs a new diagramVersion.
# VITE_INJURY_HORSE_LEFT_IMAGE=/images/injury/horse-reference-cutout-v2.png
# VITE_INJURY_HORSE_RIGHT_IMAGE=/images/injury/horse-right.png
# Without a right-side photo, the UI explicitly labels its mirrored illustration.

# Optional Google sign-in; use the same public client ID as backend GOOGLE_CLIENT_ID.
# Leave empty to hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
