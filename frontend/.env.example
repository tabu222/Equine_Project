# Public API origin is proxied to the Django backend in development.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Public Owner registration is POST /api/auth/register in this backend.
# No VITE_REGISTER_ENDPOINT or client-selected role is needed.

# Optional static whole-horse glTF 2.0 asset. Both values are required.
# No horse model is bundled. See docs/HORSE_INJURY_MAPPING.md for the asset contract.
# VITE_HORSE_MODEL_URL=/models/horse-v1.glb
# VITE_HORSE_MODEL_VERSION=horse-surface-v1
